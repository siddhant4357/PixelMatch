# ==========================================
# PixelMatch Backend - Environment Variables
# ==========================================

# 1. Database (Neon Postgres)
# Replace 'postgresql://' with 'postgresql+asyncpg://' from your Neon URL
# Example: postgresql+asyncpg://neondb_owner:xxxxxx@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_NEON_HOST/YOUR_DB_NAME?sslmode=require

# 2. Clerk Authentication
# Get these from your Clerk Dashboard -> API Keys
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx

# Upload Configuration
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=data/uploads
SELFIE_DIR=data/selfies

# Cloud Storage (Supabase S3)
S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=your_supabase_access_key
S3_SECRET_ACCESS_KEY=your_supabase_secret_key
S3_REGION=us-east-1
S3_BUCKET_NAME=pixelmatch

# 3. Model Configurations (InsightFace)
# The embedding dimension used by ArcFace (do not change)
EMBEDDING_DIM=512
# The threshold for a match (0.45 is strict enough for ArcFace)
SIMILARITY_THRESHOLD=0.45
# Faces with quality below this are skipped during upload
FACE_QUALITY_THRESHOLD=0.4
# How many faces to retrieve from FAISS before strict exact-match filtering
FAISS_TOP_K_CANDIDATES=50

# 4. Security & CORS
# Domains that are allowed to make API requests to this backend
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
